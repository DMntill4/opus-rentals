#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Shell Script for Linux / macOS / WSL
# ----------------------------------------------------------------------------
set -e

PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SAVED="`pwd`"
cd "`dirname \"$PRG\"`" >/dev/null
MAVEN_PROJECTBASEDIR="`pwd`"
cd "$SAVED" >/dev/null

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="java"
fi

exec "$JAVACMD" -jar "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" "$@"
