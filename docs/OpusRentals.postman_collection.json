          }
        },
        {
          "name": "Approve Rental (Provider)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/rentals/1/status", "host": ["{{baseUrl}}"], "path": ["rentals", "1", "status"]}
          }
        },
