            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/providers/1", "host": ["{{baseUrl}}"], "path": ["providers", "1"]}
          }
        }
      ]
    },
    {
      "name": "4. Tools & Catalog",
      "item": [
        {
          "name": "Get Tools (Public)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/tools", "host": ["{{baseUrl}}"], "path": ["tools"]}
          }
        },
        {
          "name": "Search Tools by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tools?search=excavadora",
              "host": ["{{baseUrl}}"],
              "path": ["tools"],
              "query": [{"key": "search", "value": "excavadora"}]
            }
          }
        },
        {
          "name": "Get Tool by ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/tools/1", "host": ["{{baseUrl}}"], "path": ["tools", "1"]}
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"]}
          }
