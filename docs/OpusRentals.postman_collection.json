          "name": "Process Return & Inspect Damages (4FN)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"returnDate\": \"2026-11-05\",\n  \"generalNotes\": \"Equipo devuelto en bodega norte\",\n  \"inspectorNotes\": \"Se evidencian fisuras en manguera de alta presión\",\n  \"damages\": [\n    {\n      \"description\": \"Manguera hidráulica reventada por sobrepresión\",\n      \"severity\": \"MODERATE\",\n      \"penaltyAmount\": 150000\n    }\n  ]\n}"
            },
            "url": {"raw": "{{baseUrl}}/returns/rental/1", "host": ["{{baseUrl}}"], "path": ["returns", "rental", "1"]}
          }
        }
      ]
