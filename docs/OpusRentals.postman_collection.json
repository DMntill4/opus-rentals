              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toolId\": 1,\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2026-11-05\",\n  \"notes\": \"Entrega en obra proyecto edificio Calle 93\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/rentals", "host": ["{{baseUrl}}"], "path": ["rentals"]}
          }
        },
        {
          "name": "Get Client Rentals",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
