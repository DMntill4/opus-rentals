          "name": "Create Tool (Provider)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"Excavadora Compacta Cat 305\",\n  \"brand\": \"Caterpillar\",\n  \"model\": \"305 CR\",\n  \"dailyPrice\": 320000,\n  \"depositAmount\": 1200000,\n  \"images\": [\n    {\n      \"imageUrl\": \"https://images.unsplash.com/photo-1579762715118-a6f1d4b934f1\",\n      \"isCover\": true\n    }\n  ],\n  \"specifications\": [\n    {\n      \"specKey\": \"Potencia Neta\",\n      \"specValue\": \"48.9 HP\"\n    },\n    {\n      \"specKey\": \"Profundidad de Excavación\",\n      \"specValue\": \"3.82 m\"\n    }\n  ]\n}"
