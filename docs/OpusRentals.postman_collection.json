            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos Eduardo\",\n  \"lastName\": \"Mendoza Herrera\",\n  \"phone\": \"+57 300 9876543\",\n  \"address\": \"Calle 127 #15-30 Oficina 402, Bogota\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/clients/1", "host": ["{{baseUrl}}"], "path": ["clients", "1"]}
          }
        },
        {
          "name": "Delete / Deactivate Client (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/clients/1", "host": ["{{baseUrl}}"], "path": ["clients", "1"]}
          }
        }
      ]
    },
